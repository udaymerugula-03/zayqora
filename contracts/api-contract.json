{
  "version": "1.0",
  "base_path": "/api/v1",
  "market": { "country": "Pakistan", "currency": "PKR", "timezone": "Asia/Karachi" },
  "conventions": {
    "money": "Decimal strings with two fractional digits, never JS-authoritative prices",
    "dates": "ISO 8601 UTC for timestamps; restaurant local date for availability",
    "auth": "Bearer access_token; revocable server sessions; restaurant context derived from authenticated membership",
    "lists": "{items:[],total:number,page:number,page_size:number}",
    "errors": "{detail:string,code?:string}; validation errors may use FastAPI detail arrays",
    "roles": ["owner", "platform_admin"],
    "payments": "Cash only. Public checkout never marks payment paid. Owner records cash receipt explicitly.",
    "images": "Bundled /food/*.jpg URLs; uploaded /media/* paths resolved against API origin",
    "scope": "Release 1 plus owner-operated basic order board, not the Release 2 staff/KDS/POS suite"
  },
  "entities": {
    "User": ["id", "email", "full_name", "role", "restaurant_id|null", "email_verified"],
    "Restaurant": ["id", "slug", "name", "tagline", "description", "cuisine", "city", "address", "phone", "email", "currency", "timezone", "logo_url", "hero_image_url", "published", "status:active|suspended", "allow_pickup", "allow_delivery", "delivery_fee", "minimum_order", "tax_rate", "tax_inclusive", "opening_hours:Record<mon|tue|wed|thu|fri|sat|sun,{open:string,close:string,closed:boolean}>", "reservation_duration_minutes", "reservation_buffer_minutes", "reservation_days_ahead", "plan_id|null"],
    "Category": ["id", "name", "position", "published", "items:MenuItem[]"],
    "MenuItem": ["id", "category_id", "name", "description", "image_url", "price", "available", "published", "featured", "variant_required", "variants:[{id,name,price_delta}]", "modifiers:[{id,name,price_delta}]"],
    "CartLineInput": ["menu_item_id", "quantity", "variant_id|null", "modifier_ids:string[]", "notes"],
    "Quote": ["items:[{menu_item_id,name,quantity,variant_name|null,modifier_names:string[],unit_price,line_total,notes}]", "subtotal", "delivery_fee", "tax", "total", "currency", "quote_token"],
    "Order": ["id", "reference", "tracking_token:only-on-creation", "status", "payment_status:unpaid|paid", "payment_method:cash", "fulfilment:pickup|delivery", "customer_name:staff-only", "email:staff-only", "phone:staff-only", "address:staff-only", "notes", "items:Quote.items", "subtotal", "delivery_fee", "tax", "total", "currency", "created_at", "history:[{status,created_at,reason}]"],
    "Reservation": ["id", "reference", "status", "starts_at", "ends_at", "party_size", "customer_name", "email", "phone", "notes", "table_id"],
    "DiningTable": ["id", "name", "capacity", "active"],
    "Dashboard": ["orders_today", "gross_sales", "net_sales", "pending_orders", "average_order_value", "upcoming_reservations", "recent_orders:Order[]", "top_items:[{name,quantity,revenue}]", "definitions:Record<string,string>"],
    "Plan": ["id", "name", "description", "max_menu_items", "active"]
  },
  "endpoints": [
    ["POST", "/auth/login", "{email,password}", "{access_token,token_type:'bearer',user:User}"],
    ["GET", "/auth/me", "", "User"],
    ["POST", "/auth/logout", "", "{message}"],
    ["POST", "/auth/register", "{full_name,email,password,restaurant_name,slug}", "{message,verification_required:true,email_delivery_status}"],
    ["POST", "/auth/verify-email", "{token}", "{message}"],
    ["GET", "/public/restaurants", "", "Page<Restaurant>"],
    ["GET", "/public/restaurants/{slug}", "", "Restaurant"],
    ["GET", "/public/restaurants/{slug}/menu", "", "{categories:Category[]}"],
    ["GET", "/public/plans", "", "{items:Plan[]}"],
    ["POST", "/public/restaurants/{slug}/quote", "{items:CartLineInput[],fulfilment}", "Quote"],
    ["POST", "/public/restaurants/{slug}/orders", "Idempotency-Key header; {items,fulfilment,quote_token,customer_name,email,phone,address,notes,consent:true}", "Order with private tracking_token"],
    ["GET", "/public/orders/{tracking_token}", "", "Order without contact/address/internal notes"],
    ["GET", "/public/restaurants/{slug}/availability?date=YYYY-MM-DD&party_size=N", "", "{slots:[{starts_at,ends_at}]}"],
    ["POST", "/public/restaurants/{slug}/reservations", "{starts_at,party_size,customer_name,email,phone,notes,consent:true}", "Reservation"],
    ["GET", "/restaurant", "", "Restaurant (owner)"],
    ["PATCH", "/restaurant", "Editable Restaurant fields; published validates setup", "Restaurant"],
    ["GET", "/menu/categories", "", "{items:Category[]}"],
    ["POST", "/menu/categories", "{name,position,published}", "Category"],
    ["PATCH", "/menu/categories/{id}", "{name?,position?,published?}", "Category"],
    ["POST", "/menu/items", "Editable MenuItem fields; variant/modifier IDs optional on create", "MenuItem"],
    ["PATCH", "/menu/items/{id}", "Partial editable MenuItem fields", "MenuItem"],
    ["GET", "/orders?page=1&page_size=20&status=&q=", "", "Page<Order>"],
    ["GET", "/orders/{id}", "", "Order"],
    ["PATCH", "/orders/{id}/status", "{status,reason?}", "Order"],
    ["POST", "/orders/{id}/cash-payment", "", "Order"],
    ["GET", "/reservations?page=1&page_size=20&status=", "", "Page<Reservation>"],
    ["PATCH", "/reservations/{id}/status", "{status,reason?}", "Reservation"],
    ["GET", "/tables", "", "{items:DiningTable[]}"],
    ["POST", "/tables", "{name,capacity,active}", "DiningTable"],
    ["PATCH", "/tables/{id}", "{name?,capacity?,active?}", "DiningTable"],
    ["GET", "/reports/dashboard", "", "Dashboard"],
    ["GET", "/reports/sales?from_date=YYYY-MM-DD&to_date=YYYY-MM-DD", "", "Dashboard plus reporting period"],
    ["POST", "/media", "multipart file; owner-only", "{url}"],
    ["GET", "/notifications", "", "Page<{id,kind,subject,status,created_at}>"],
    ["GET", "/platform/overview", "", "{total_tenants,active_tenants,suspended_tenants,published_restaurants,total_orders}"],
    ["GET", "/platform/tenants?page=1&page_size=20&q=", "", "Page<Restaurant>"],
    ["PATCH", "/platform/tenants/{id}/status", "{status,reason}", "Restaurant"],
    ["PATCH", "/platform/tenants/{id}/plan", "{plan_id,reason}", "Restaurant"],
    ["GET", "/platform/plans", "", "{items:Plan[]}"],
    ["POST", "/platform/plans", "{name,description,max_menu_items,active}", "Plan"],
    ["PATCH", "/platform/plans/{id}", "{name?,description?,max_menu_items?,active?}", "Plan"]
  ],
  "order_transitions": {
    "PENDING": ["CONFIRMED", "REJECTED", "CANCELLED"],
    "CONFIRMED": ["PREPARING", "CANCELLED"],
    "PREPARING": ["READY", "CANCELLED"],
    "READY": ["OUT_FOR_DELIVERY", "COMPLETED"],
    "OUT_FOR_DELIVERY": ["COMPLETED"],
    "COMPLETED": [],
    "REJECTED": [],
    "CANCELLED": []
  },
  "reservation_transitions": {
    "REQUESTED": ["CONFIRMED", "DECLINED", "CANCELLED"],
    "CONFIRMED": ["SEATED", "CANCELLED", "NO_SHOW"],
    "SEATED": ["COMPLETED"],
    "COMPLETED": [],
    "CANCELLED": [],
    "DECLINED": [],
    "NO_SHOW": []
  },
  "safety": [
    "New registrations require email verification; absent mail credentials must be explicitly surfaced, not pretend sent.",
    "Public orders require current signed quote; price/availability changes force re-quote and explicit reconfirmation.",
    "Order creation is transactional and idempotent, including changed payload rejection for reused keys.",
    "Reservations allocate a suitable table with transaction-safe overlap and buffer checks; REQUESTED also holds capacity.",
    "Suspended/unpublished restaurants are not public and cannot accept orders/reservations.",
    "Cash payment recording must be explicit, auditable and duplicate-safe.",
    "Status colors are semantic; one ZAYQORA logo, typography, navy/teal theme shared across every interface.",
    "All mock/seed data must be marked demonstration; do not claim payment, email, GPS, certifications or production readiness that are not configured."
  ]
}
