DATABASE_URL=postgresql+psycopg://zayqora_app:replace-me@localhost:5432/zayqora
SECRET_KEY=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:3000
ENVIRONMENT=development
API_ORIGIN=http://127.0.0.1:8086

# Configure a real sender before enabling registration email delivery.
# Never copy provider secrets into NEXT_PUBLIC_* variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Public restaurant imagery only. Use a dedicated store for this application.
BLOB_READ_WRITE_TOKEN=
